# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=replace_with_your_api_id
TELEGRAM_API_HASH=replace_with_your_api_hash

# Optional: an authorized Telethon StringSession. Keep it secret.
# If blank, first login stores the authorized session locally in SESSION_FILE instead.
TELEGRAM_SESSION=
SESSION_FILE=.telegram-bridge-session

# Standard accounts: 2 GiB. Set to 4 only for an account/client eligible for 4 GiB uploads.
MAX_UPLOAD_GB=2
